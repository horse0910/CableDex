@@ -988,6 +990,26 @@ sc_screen_apply_frame(struct sc_screen *screen, bool can_resize) {
     }
 
     sc_screen_render(screen, false);
+    // Mac-only timing: complete packet received -> decode/queue -> render submission.
+    // This excludes phone rendering/encoding, USB transit, input transit, panel scanout.
+    if (frame->opaque_ref && frame->opaque_ref->size >= sizeof(sc_tick)) {
+        sc_tick now = sc_tick_now();
+        sc_tick received = *(const sc_tick *) frame->opaque_ref->data;
+        sc_tick elapsed = now - received;
+        static sc_tick sum, maximum, last_report;
+        static unsigned count;
+        if (elapsed >= 0 && elapsed < SC_TICK_FROM_SEC(10)) {
+            sum += elapsed;
+            if (elapsed > maximum) maximum = elapsed;
+            ++count;
+        }
+        if (!last_report) last_report = now;
+        if (count && now - last_report >= SC_TICK_FROM_SEC(1)) {
+            LOGI("CDX_METRIC host_ms avg=%.3f max=%.3f n=%u",
+                 (double) sum / count / 1000.0, (double) maximum / 1000.0, count);
+            sum = maximum = 0; count = 0; last_report = now;
+        }
+    }
     return true;
 }
 
